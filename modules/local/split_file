nextflow_process {

    name "Test Process SPLIT_FILE"
    script "modules/local/split_file/main.nf"
    process "SPLIT_FILE"

    test("Should split file into multiple parts") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'split_sample' ],
                    file("${projectDir}/test-data/unsplit.fastq", checkIfExists: false)
                ]
                input[1] = '.fastq'
                input[2] = 1000
                """
            }
        }

        then {
            assert process.success

            with(process.out) {
                assert split_files.size() >= 1
                assert path(split_files.get(0)).name.contains('.fastq')
                assert versions.size() == 1
            }
        }

    }

    test("Should use correct file extension") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'fasta_split' ],
                    file("${projectDir}/test-data/sequences.fasta", checkIfExists: false)
                ]
                input[1] = '.fasta'
                input[2] = 500
                """
            }
        }

        then {
            assert process.success

            with(process.out.split_files) {
                assert size() >= 1
                assert every { path(it).name.endsWith('.fasta') }
            }
        }

    }

    test("Should track split tool version") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'version_test' ],
                    file("${projectDir}/test-data/unsplit.fastq", checkIfExists: false)
                ]
                input[1] = '.fastq'
                input[2] = 1000
                """
            }
        }

        then {
            assert process.success

            with(process.out.versions) {
                assert size() == 1
                def versions_yaml = path(get(0)).text
                assert versions_yaml.contains('split:')
            }
        }

    }

}